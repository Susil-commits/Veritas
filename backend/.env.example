# Backend Environment Variables (Render)
# In Render Service Dashboard -> Environment, add:

GEMINI_API_KEY=your_gemini_api_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here  # Supabase Dashboard -> Settings -> API -> JWT Settings
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
FRONTEND_URL=https://your-app.vercel.app
ENVIRONMENT=production

# ── Optional / Feature-Specific ───────────────────────────────────────────────
SESSION_SECRET_KEY=your_session_secret_key_hex_32_bytes_here
VERITAS_MCP_API_KEY=your_mcp_api_key_here  # Required if calling /mcp endpoints (fail-closed)
REDIS_PASSWORD=your_redis_password_here     # Required if running via docker-compose
